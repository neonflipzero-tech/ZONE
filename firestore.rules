rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Global Safety Net: Default Deny
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions (Phase 3 Primitives)
    // ===============================================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
        (request.auth.token.email == "zaikiwildan@gmail.com" && request.auth.token.email_verified == true)
      );
    }

    function isValidId(id) {
       return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // ===============================================================
    // Domain Validators (Phase 4 Blueprint)
    // ===============================================================

    function isValidUser(data) {
      let allowedFields = [
        'userId', 'username', 'level', 'xp', 'totalXp', 'equippedFrame', 
        'equippedTitle', 'profilePicture', 'streak', 'badgesCount', 
        'framesCount', 'missionsCompleted', 'isProfilePublic', 'ovr', 
        'stats', 'lastActive', 'role', 'missionAffinity', 'dataVersion'
      ];
      
      // Strict Key Enforcement & Required Fields
      return data.keys().hasAll(['userId', 'username', 'level', 'xp', 'totalXp', 'lastActive']) &&
             // Using Set logic via MapDiff for hasOnly equivalent check if possible, 
             // but since hasOnly on keys() might fail depending on version, we use list check if supported or simple comparison
             data.keys().size() <= allowedFields.size() &&
             
             // Identity Integrity
             data.userId == request.auth.uid &&
             
             // Type Safety & Boundary Limits (Pillar 2 & 5)
             data.username is string && data.username.size() > 0 && data.username.size() <= 64 &&
             data.level is number && data.level >= 1 && data.level <= 100 &&
             data.xp is number && data.xp >= 0 &&
             data.totalXp is number && data.totalXp >= 0 &&
             data.lastActive is number &&
             
             // Optional Field Hardening
             (!('profilePicture' in data) || data.profilePicture == null || (data.profilePicture is string && data.profilePicture.size() <= 500)) &&
             (!('equippedFrame' in data) || data.equippedFrame == null || (data.equippedFrame is string && data.equippedFrame.size() <= 64)) &&
             (!('equippedTitle' in data) || data.equippedTitle == null || (data.equippedTitle is string && data.equippedTitle.size() <= 64)) &&
             (!('streak' in data) || (data.streak is number && data.streak >= 0)) &&
             (!('ovr' in data) || (data.ovr is number && data.ovr >= 0 && data.ovr <= 100)) &&
             (!('isProfilePublic' in data) || data.isProfilePublic is bool) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 20));
    }

    // ===============================================================
    // Resource Rules
    // ===============================================================

    match /users/{userId} {
      // Rule 3: Path Variable Hardening
      // Rule 8: Secure List Queries (The "Query Enforcer")
      allow get: if isOwner(userId) || (existing().isProfilePublic == true);
      allow list: if isSignedIn() && (resource.data.isProfilePublic == true || resource.data.userId == request.auth.uid);
      
      // Rule 10: Temporal Integrity & Immutable Fields
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && 
                       (!('role' in incoming()) || incoming().role == 'user');
      
      // Rule 4: Tiered Identity Logic & Action-Based Updates
      allow update: if (
        (isOwner(userId) && isValidUser(incoming()) && (
          // Immortal Field Rule (Pillar 9)
          incoming().userId == existing().userId &&
          
          // Action-Based Field Restrictions (Pillar 4)
          // Action 1: Standard Progress (XP/Level/Stats)
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'xp', 'totalXp', 'level', 'lastActive', 'stats', 'missionAffinity', 
            'missionsCompleted', 'ovr', 'streak', 'badgesCount', 'framesCount', 
            'dataVersion'
          ])) ||
          // Action 2: Settings Update (Public/Private/Customization)
          (incoming().diff(existing()).affectedKeys().hasOnly([
            'username', 'isProfilePublic', 'equippedFrame', 'equippedTitle', 
            'profilePicture', 'lastActive'
          ]))
        ) && (
          // Prevent self-escalation
          (!('role' in incoming()) && !('role' in existing())) || 
          (incoming().role == existing().role)
        )) || 
        isAdmin()
      );
      
      allow delete: if isOwner(userId) || isAdmin();
    }
  }
}
